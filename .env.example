# Copy this file to .env.local and enter the API key locally.
# Never commit real credentials or expose them to client-side code.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Keep live generation disabled until a testing budget has been agreed.
DEEPSEEK_API_ENABLED=false

# Select a supported model after checking the account and current API docs.
DEEPSEEK_MODEL=
