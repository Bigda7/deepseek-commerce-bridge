{
  "name": "deepseek-commerce-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "demo:live": "node --env-file=.env.local scripts/interactive-demo.mjs --start-live-session --interview-session",
    "check:public": "node scripts/check-public-release.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src tests data package.json tsconfig.json next.config.ts eslint.config.mjs vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
